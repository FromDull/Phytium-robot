<?xml version="1.0"?>
<package format="3">
  <name>gimbal_camera_tf_ros2</name>
  <version>0.2.0</version>
  <description>Publish calibrated Astra camera TF from validated gimbal telemetry.</description>
  <maintainer email="cnvhk@todo.todo">cnvhk</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
