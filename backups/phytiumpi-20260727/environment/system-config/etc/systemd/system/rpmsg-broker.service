[Unit]
Description=Single-owner OpenAMP RPMsg request broker
After=openamp-initproc.service
Requires=openamp-initproc.service
PartOf=openamp-initproc.service

[Service]
Type=simple
User=root
Group=user
RuntimeDirectory=rpmsg-broker
RuntimeDirectoryMode=0750
ExecStart=/usr/local/sbin/rpmsg-broker --device /dev/rpmsg0 --socket /run/rpmsg-broker/rpmsg.sock --monitor-socket /run/rpmsg-broker/monitor.sock
Restart=on-failure
RestartSec=1

[Install]
WantedBy=multi-user.target
