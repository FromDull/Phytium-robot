[Unit]
Description=Allowlisted robot service control for the web dashboard
After=basic.target

[Service]
Type=simple
ExecStart=/usr/local/libexec/robot-service-control
RuntimeDirectory=robot-service-control
RuntimeDirectoryMode=0755
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
