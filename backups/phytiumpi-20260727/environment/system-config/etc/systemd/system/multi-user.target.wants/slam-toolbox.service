[Unit]
Description=SLAM Toolbox online mapping
After=docker.service rplidar.service
Requires=docker.service rplidar.service

[Service]
Type=simple
User=user
Environment=ROS_DOMAIN_ID=10
ExecStart=/home/user/rplidar_deploy/slam/run-slam.sh
ExecStop=-/usr/bin/docker stop --time 10 slam_toolbox
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
