[Unit]
Description=SLAMTEC RPLIDAR A2M6 ROS 2 driver
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=user
Environment=ROS_DOMAIN_ID=10
Environment=RPLIDAR_DEVICE=/dev/rplidar
ExecStart=/home/user/rplidar_deploy/run-rplidar.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
