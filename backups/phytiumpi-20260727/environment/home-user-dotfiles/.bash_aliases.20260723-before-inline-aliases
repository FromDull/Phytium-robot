# Restored OpenAMP workflow aliases.
alias cdamp='cd "$HOME/openamp_rpmsg_comm"'
alias rcedit='nano "$HOME/.bashrc"'
alias rcsource='source "$HOME/.bashrc"'
alias cpelf='sudo install -m 0644 "$HOME/openamp_core0.elf" /lib/firmware/openamp_core0.elf'
alias reloadrproc='sudo systemctl restart openamp-initproc.service'
alias reloadproc='reloadrproc'
alias rpstatus='systemctl --no-pager --full status openamp-initproc.service rpmsg-broker.service gimbal-daemon.service'
alias rprun='cd "$HOME/openamp_rpmsg_comm" && sudo ./build/rpmsg_client /dev/rpmsg0'
alias canfree='sudo ip link set can0 down 2>/dev/null; sudo ip link set can1 down 2>/dev/null; echo 2800a000.can | sudo tee /sys/bus/platform/drivers/phytium_can_platform/unbind 2>/dev/null; echo 2800b000.can | sudo tee /sys/bus/platform/drivers/phytium_can_platform/unbind 2>/dev/null; ip link'
alias imuwatch='cd "$HOME/openamp_rpmsg_comm" && sudo watch -n 0.1 "./build/rpmsg_client /dev/rpmsg0 imuread"'
alias gimbalrun='cd "$HOME/openamp_rpmsg_comm" && sudo ./build/gimbal_test /dev/rpmsg0'
alias cdros2='sudo docker exec -it phytium_ros2 bash'
alias initproc='reloadrproc'
alias rplog='cd "$HOME/openamp_rpmsg_comm" && sudo ./build/balance_logger'
alias gimbalstatus='python3 "$HOME/openamp_rpmsg_comm/linux_user/gimbalctl.py" status'
